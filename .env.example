# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=football_tournament

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# SMTP Configuration (Optional - OTP will be logged to console if not configured)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# ── Email deliverability (helps OTP mails land in the inbox, not spam) ────────
# One consistent brand name shown as the sender across ALL emails.
MAIL_FROM_NAME=ATB Sports
# Visible From address. Keep it equal to SMTP_USER (or a verified alias on the
# SAME domain) so SPF/DKIM/DMARC stay aligned. Defaults to SMTP_USER if unset.
# MAIL_FROM_ADDRESS=no-reply@yourdomain.com
# Where replies go. Defaults to MAIL_FROM_ADDRESS if unset.
# MAIL_REPLY_TO=support@yourdomain.com
#
# Optional DKIM signing — ONLY when sending from a domain you own with the DKIM
# public key published in DNS. Leave blank for Gmail SMTP (Google signs for you).
# DKIM_DOMAIN=yourdomain.com
# DKIM_SELECTOR=mail
# DKIM_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Server Configuration
PORT=3000

# Admin contact shown in the "awaiting admin approval" message when an inactive
# (newly registered, not-yet-approved) user tries to log in.
ADMIN_CONTACT_EMAIL=admin@atbsports.com
ADMIN_CONTACT_PHONE=+49 000 0000000

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:4200
# Public URL of the deployed frontend — used in web password-reset email links
FRONTEND_URL=http://localhost:4200
# Custom-scheme deep link base for the Flutter mobile app — used when a
# forgot-password request is sent with { "platform": "mobile" }.
# Final link becomes: <MOBILE_RESET_LINK>?token=<token>
MOBILE_RESET_LINK=footballapp://reset-password
