# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=football_tournament

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# SMTP Configuration (Optional - OTP will be logged to console if not configured)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# Server Configuration
PORT=3000

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:4200
# Public URL of the deployed frontend — used in web password-reset email links
FRONTEND_URL=http://localhost:4200
# Custom-scheme deep link base for the Flutter mobile app — used when a
# forgot-password request is sent with { "platform": "mobile" }.
# Final link becomes: <MOBILE_RESET_LINK>?token=<token>
MOBILE_RESET_LINK=footballapp://reset-password
